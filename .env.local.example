# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings > API in the Supabase dashboard). .env.local is
# gitignored — never commit real keys.
#
# The anon key is safe to ship to the browser: it has no power beyond what
# RLS in schema.sql grants (see allowed_users / is_allowed_user()).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
